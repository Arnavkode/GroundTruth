# Groundtruth environment
#
# Leave ANTHROPIC_API_KEY unset (or set to a placeholder) to run entirely in
# mock mode. Mock mode is the default and is what tonight's build was verified
# against. See MORNING_CHECKLIST.md before setting a real key.
#
# ANTHROPIC_API_KEY=sk-ant-placeholder

# Model used for the resolver's LLM reasoning step in real mode.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Rate limiter (guards real API spend — see lib/ratelimit.ts)
RATE_LIMIT_PER_IP_PER_HOUR=10
DAILY_REAL_CALL_CAP=200

# Force mock mode even when a real key is present (useful for demos).
# FORCE_MOCK_MODE=1
