# Groundtruth environment
#
# Leave GEMINI_API_KEY unset (or set to a placeholder) to run entirely in
# mock mode. Mock mode is the default and is what tonight's build was verified
# against. See MORNING_CHECKLIST.md before setting a real key.
#
GEMINI_API_KEY=

# Model used for the resolver's reasoning step in real mode.
# Free tier, no billing account attached — past the quota a request 429s and stops.
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Spend guards (see lib/ratelimit.ts) ─────────────────────────────────────
# Tightened for public exposure. Every one of these falls back to mock mode
# rather than erroring when it trips.
# Counts live CALLS, one per transaction reasoned — not runs. A 16-unit
# reconcile at 3 would get real reasoning on three units and canned on thirteen.
RATE_LIMIT_PER_IP_PER_HOUR=3
# Sized well under the provider's free 1000 requests/day so we never reach their ceiling.
DAILY_REAL_CALL_CAP=300

# Most live calls a single run may make, whatever the per-IP budget allows.
# Defaults to 16 — the size of the bundled fixture set — so a full reconcile
# resolves live end to end rather than going canned partway through.
# MAX_REAL_CALLS_PER_RUN=16

# Uploads (file validation only, no model calls) are limited separately.
# RATE_LIMIT_INGEST_PER_HOUR=20

# Kill switch. Set to 1 in the Vercel dashboard to force mock mode instantly,
# no redeploy, regardless of key presence or remaining budget.
# DISABLE_REAL_MODE=1

# Persistent rate-limit store. WITHOUT THESE the limiter is per-serverless-
# instance, so the effective public limit is (configured limit x instances).
# Set both before putting a real key on a public deployment.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# Force mock mode even when a real key is present (useful for demos).
# FORCE_MOCK_MODE=1
